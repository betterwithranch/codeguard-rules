{
  "extraKnownMarketplaces": {
    "codeguard": {
      "source": {
        "source": "github",
        "repo": "betterwithranch/codeguard",
        "ref": "v0"
      }
    }
  },
  "enabledPlugins": {
    "codeguard@codeguard": true
  },
  "permissions": {
    "allow": [
      "Bash(codeguard:*)",
      "Bash(task test:*)",
      "Bash(task eval:*)",
      "Bash(uv tool install:*)"
    ]
  }
}
